# ============================================================
# Whisper Unified — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- AI Models (can be gigabytes) ---
models/

# --- User audio input ---
audio/
*.wav
*.mp3
*.mp4
*.m4a
*.ogg
*.flac
*.aac
*.opus
*.wma
*.webm

# --- Transcription output ---
audio_to_text/
args_output/
*.srt
*.txt
!README.md
!README.ru.md

# --- Logs ---
*.log

# --- IDE & OS ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
Thumbs.db
.DS_Store
desktop.ini

# --- Distribution / packaging ---
dist/
build/
*.egg-info/
*.egg

# --- AI Rules / Agent Context ---
.cursorrules
AI_AGENT_RULES.md
OPTIMIZATIONS.md
