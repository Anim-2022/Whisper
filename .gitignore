# ============================================================
# Whisper Unified — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# --- Virtual environments ---
.venv/
.venv-fw/
.venv-torch/
venv/
env/
ENV/

# --- AI Models (can be gigabytes) ---
models/

# --- User audio input ---
audio/
*.wav
*.mp3
*.mp4
*.m4a
*.ogg
*.flac
*.aac
*.opus
*.wma
*.webm

# --- Transcription output ---
# Directory rules only. Every writer targets one of these, so there is no need for
# blanket *.txt / *.srt patterns — and those actively caused trouble: they fought
# the READMEs (hence the fragile !README.* negation list, which was already missing
# README.uk.md) and would now swallow the requirements-*.txt files.
audio_to_text/
args_output/
predictions/
references/

# --- Logs ---
*.log

# --- IDE & OS ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
Thumbs.db
.DS_Store
desktop.ini

# --- Claude Code / agent state ---
.claude/
.claudeignore

# --- App-local user data (settings.json lives here in dev runs) ---
.whisper_gui/

# --- Local smoke tests / scratch ---
_smoke_*.py
scratch/

# --- Test & lint caches ---
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Distribution / packaging ---
dist/
build/
*.egg-info/
*.egg

# --- AI Rules / Agent Context ---
.cursorrules
AI_AGENT_RULES.md
OPTIMIZATIONS.md
